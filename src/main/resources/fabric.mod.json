{
  "schemaVersion": 1,
  "id": "unity-client",
  "version": "${version}",
  "name": "Unity Client",
  "description": "A clean, modular Fabric utility client framework for allowed anarchy/private server use.",
  "authors": [
    "Unity Client contributors"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.unityclient.UnityClientMod"
    ]
  },
  "mixins": [
    "unityclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
